# Copia este archivo como `.dev.vars` (sin .example) para probar el Worker en tu PC con
# `npx wrangler dev --config worker/wrangler.toml --local`. El archivo `.dev.vars` NO se sube a git.
# En producción estos valores se guardan con `npx wrangler secret put NOMBRE`. Ver docs/DESPLIEGUE.md.

# Token que usa la app para hablar con el servidor (invéntalo largo y aleatorio)
API_TOKEN=token-local
# PIN para los borrados definitivos
PIN_BORRADO=4321
