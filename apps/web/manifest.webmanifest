{
  "name": "Mis finanzas",
  "short_name": "Finanzas",
  "description": "Registra tus gastos con un mensaje. Funciona sin conexión.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuevo gasto",
      "short_name": "Gasto",
      "description": "Escribir un gasto",
      "url": "./?accion=gasto",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dictar por voz",
      "short_name": "Voz",
      "description": "Contar un gasto hablando",
      "url": "./?accion=voz",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ver saldos",
      "short_name": "Saldos",
      "description": "Cuánta plata tienes",
      "url": "./?accion=saldos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "imagen",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
